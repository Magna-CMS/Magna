# The test environment.
#
# Laravel loads this instead of .env whenever APP_ENV=testing, which phpunit.xml
# sets. It exists so the test database is stated in a file a developer will
# look in, rather than only in phpunit.xml — but it is not the protection.
#
# The protection is tests/bootstrap.php, which sets these before the framework
# boots and refuses to run at all while a cached configuration is present. A
# cached config would make every value in this file unreachable, which is
# exactly how the development database was destroyed on 13 August 2026.
APP_ENV=testing
APP_KEY=base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
APP_DEBUG=true

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4

MAGNA_INSTALLED=true
