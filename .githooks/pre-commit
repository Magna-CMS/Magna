#!/bin/sh
# Local definition-of-done gate (see the project coding standards).
#
# Runs the two fast checks on every commit so a style or type error is
# caught before it reaches CI:
#   1. pint --test on the staged PHP files
#   2. phpstan     — level 9 on the staged PHP source files
#
# The full test suite stays a CI/pre-push concern — it is far too slow for
# a commit hook. Bypassing with --no-verify is possible but the same
# failures then land in CI, where they block the merge anyway.
#
# Activate with:  composer setup-hooks   (or automatically on composer install)

set -e

# Git runs hooks under its own sh, whose PATH may not carry php (Herd on
# Windows, for one). Resolve it: an explicit `git config hooks.php` wins,
# then PATH, then the Herd install locations.
PHP="$(git config hooks.php || true)"

if [ -z "$PHP" ] && command -v php >/dev/null 2>&1; then
    PHP=php
fi

if [ -z "$PHP" ]; then
    # Newest install first: the glob sorts ascending, so walk it in reverse
    # rather than settling for php83 when php84 sits right next to it.
    for candidate in $(ls -r "$HOME"/.config/herd/bin/php*/php.exe 2>/dev/null); do
        if [ -x "$candidate" ]; then
            PHP="$candidate"
            break
        fi
    done
fi

if [ -z "$PHP" ]; then
    echo "pre-commit: php not found. Point the hooks at one with:" >&2
    echo "  git config hooks.php /path/to/php" >&2
    exit 1
fi

# Only the paths the phpstan config analyses. Test files deliberately stay
# out: they are not in the config's paths, and analysing one standalone
# reports Pest/Mockery extension methods as undefined.
staged_php=$(git diff --cached --name-only --diff-filter=ACMR |
    grep -E '^(src|app|database)/.*\.php$' || true)

staged_any_php=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.php$' || true)

if [ -z "$staged_any_php" ]; then
    exit 0
fi

# The staged LIST, not --dirty: --dirty resolves files against the
# worktree, so it misses a partially-staged file's staged content and
# fails the commit over unrelated dirty files.
echo "pre-commit: pint --test (staged files)"
# shellcheck disable=SC2086
"$PHP" vendor/bin/pint --test $staged_any_php

if [ -n "$staged_php" ]; then
    echo "pre-commit: phpstan (staged source files)"
    # shellcheck disable=SC2086
    "$PHP" vendor/bin/phpstan analyse --no-progress --memory-limit=1G $staged_php
fi
