includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 9

    # Inside the checkout, not the system temp directory. Two checkouts of this
    # repository analysing at once — a session working in a git worktree while a
    # release builds in another — shared %TEMP%/phpstan and tore each other's
    # cache entries out mid-run:
    #
    #   RecursiveDirectoryIterator(...Temp/phpstan/cache/PHPStan/7a/a9):
    #   The system cannot find the file specified
    #
    # which aborts the analysis and reads like a broken install. Relative, so it
    # resolves against THIS config file and every checkout gets its own; `build/`
    # is gitignored.
    tmpDir: build/phpstan

    paths:
        - app
        - src
        - database

    # Larastan forbids env() outside the config directories. Core's own
    # config defaults live in src/Magna/Config/defaults — inside the one path
    # every core updater has ever overlaid, so they reach a site on any hop —
    # and are config in every sense but their address. A non-empty list
    # REPLACES Larastan's default of config_path(), so `config` is named too.
    configDirectories:
        - config
        - src/Magna/Config/defaults

    # ArchitectureTest holds this list shrink-only — entries can be removed,
    # never added. The whole src/Magna/Admin tree (once a blanket exclusion)
    # analyses at level 9 as of W4-1.
    excludePaths:
        # Reusable trait offered to plugin authors (documented in
        # plugin-development-guide.md). Its only consumers are installed
        # plugins, outside PHPStan's paths, so it structurally reads as
        # "unused" here even though it is part of the public extension API.
        - src/Magna/Media/Concerns/IngestsMedia.php
        # Livewire component with deeply nested dynamic `public array $sections`
        # that Livewire hydrates and mutates at runtime. PHPStan cannot narrow the
        # nested mixed types through reference-based mutations and array_splice
        # calls.
        - src/Magna/Blocks/Livewire
