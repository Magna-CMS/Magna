<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            First-party plugins ship their own tests, and until this entry
            existed none of them ran in CI: `php artisan test` reads these
            testsuites, and the marketplace's licence, payment and console
            tests sat outside all of them. A test nobody runs is a comment.
        -->
        <testsuite name="Plugins">
            <directory>plugins-dev/*/*/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="MAGNA_INSTALLED" value="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Marketplace credentials default to unset in tests; the .env may carry
             local placeholders that would otherwise leak in. Tests that need them
             set config() explicitly. -->
        <env name="MARKETPLACE_TURNSTILE_SITE_KEY" value=""/>
        <env name="MARKETPLACE_TURNSTILE_SECRET" value=""/>
        <env name="MARKETPLACE_GOOGLE_CLIENT_ID" value=""/>
        <env name="MARKETPLACE_GOOGLE_CLIENT_SECRET" value=""/>
        <env name="MARKETPLACE_GITHUB_CLIENT_ID" value=""/>
        <env name="MARKETPLACE_GITHUB_CLIENT_SECRET" value=""/>
        <!-- Password strength is validated locally in tests; the
             have-i-been-pwned lookup would make every password assertion a
             live network call. -->
        <env name="MAGNA_PASSWORD_CHECK_COMPROMISED" value="false"/>
    </php>
</phpunit>
