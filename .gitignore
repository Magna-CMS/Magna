# Built release archives are published as GitHub Release assets, never committed.
/downloads/*
!/downloads/README.md
/public/build
/public/fonts-manifest.dev.json
/public/hot
# A plugin's built portal, copied here so the web server can serve it without
# booting PHP. Generated by the plugin (Roya\Erp\Services\PortalAssets) and
# republished whenever the bundle it came from changes, so committing it would
# put a second copy of another repo's build output in this one.
/public/erp
/public/storage
/storage/*.key
/storage/pail
/storage/app/plugin-manager
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

